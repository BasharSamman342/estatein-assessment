APP_NAME=Estatein
APP_ENV=local
APP_KEY=
APP_DEBUG=false
# Must include the port: image URLs in the API are built from it.
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL from XAMPP/MAMP, or `docker compose up -d` at the repo root.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=estatein
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# The only origin allowed by CORS (the Vue SPA).
FRONTEND_URL=http://localhost:5173

# Admin bearer tokens expire after this many minutes.
SANCTUM_EXPIRATION=480

# Seeded admin account (defaults: admin@estatein.test / password).
ADMIN_EMAIL=admin@estatein.test
ADMIN_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@estatein.test"
MAIL_FROM_NAME="${APP_NAME}"
